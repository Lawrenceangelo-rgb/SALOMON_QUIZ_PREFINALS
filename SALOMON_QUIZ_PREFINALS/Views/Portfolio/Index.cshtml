@model IEnumerable<ModernPortfolio.Models.Project>
@{
    ViewData["Title"] = "Projects Table of Contents";
}

<div class="text-center mb-5">
    <h1 class="fw-bold text-light">Developer Portfolio</h1>
    <p class="text-secondary fs-5">A collection of my software development projects, systems, and tools.</p>
</div>

<div class="card mb-5 p-4">
    <h4 class="text-info mb-3"><i class="bi bi-list-nested me-2"></i>Table of Contents</h4>
    <div class="list-group list-group-flush">
        @foreach (var project in Model)
        {
            <a href="#project-@project.Id" class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
                <span><strong>#@project.Id</strong> - @project.Title</span>
                <span class="badge bg-secondary">@project.Category</span>
            </a>
        }
    </div>
</div>

<h3 class="mb-4 text-light"><i class="bi bi-grid-3x3-gap me-2"></i>Featured Projects</h3>
<div class="row g-4">
    @foreach (var project in Model)
    {
        <div class="col-md-4" id="project-@project.Id">
            <div class="card h-100">
                <img src="@project.ThumbnailUrl" class="card-img-top" alt="@project.Title" style="height: 180px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/400x200/1e293b/38bdf8?text=Project+Thumbnail';" />
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-info text-dark mb-2 align-self-start">@project.Category</span>
                    <h5 class="card-title text-light fw-bold">@project.Title</h5>
                    <p class="card-text text-secondary small flex-grow-1">@project.ShortDescription</p>

                    <div class="mb-3">
                        @foreach (var tech in project.TechStack)
                        {
                            <span class="badge badge-tech me-1 mb-1">@tech</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-info btn-sm">
                            View Details <i class="bi bi-arrow-right"></i>
                        </a>
                        <a href="@project.GitHubUrl" target="_blank" class="text-light fs-5" title="View GitHub Repository">
                            <i class="bi bi-github"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>