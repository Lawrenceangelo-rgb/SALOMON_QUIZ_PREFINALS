@model ModernPortfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4">
    <i class="bi bi-arrow-left"></i> Back to Table of Contents
</a>

<div class="card p-4 mb-4">
    <div class="row g-4">
        <div class="col-md-5">
            <img src="@Model.ThumbnailUrl" class="img-fluid rounded border border-secondary" alt="@Model.Title" onerror="this.src='https://via.placeholder.com/600x400/1e293b/38bdf8?text=Project+Image';" />
        </div>
        <div class="col-md-7">
            <span class="badge bg-info text-dark mb-2">@Model.Category</span>
            <h2 class="text-light fw-bold">@Model.Title</h2>
            <p class="text-secondary mt-3">@Model.FullDescription</p>

            <div class="mb-3">
                <h6 class="text-info">Tech Stack:</h6>
                @foreach (var tech in Model.TechStack)
                {
                    <span class="badge badge-tech fs-6 me-1 mb-1">@tech</span>
                }
            </div>

            <div class="mt-4">
                <a href="@Model.GitHubUrl" target="_blank" class="btn btn-primary me-2">
                    <i class="bi bi-github me-1"></i> GitHub Repository
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h4 class="text-light mb-3"><i class="bi bi-chat-left-text me-2"></i>Comments (@Model.Comments.Count)</h4>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <form asp-action="AddComment" method="post" class="mb-4">
            <input type="hidden" name="projectId" value="@Model.Id" />
            <div class="mb-2">
                <input type="text" name="author" class="form-control bg-dark text-light border-secondary" placeholder="Your Name" required />
            </div>
            <div class="mb-2">
                <textarea name="text" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Leave a comment..." required></textarea>
            </div>
            <button type="submit" class="btn btn-info btn-sm">Post Comment</button>
        </form>
    }
    else
    {
        <div class="alert alert-warning border-secondary mb-4">
            <i class="bi bi-lock me-1"></i> You must <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="alert-link">log in</a> to post a comment.
        </div>
    }

    <div class="list-group list-group-flush">
        @if (Model.Comments.Any())
        {
            @foreach (var comment in Model.Comments.OrderByDescending(c => c.PostedAt))
            {
                <div class="list-group-item bg-transparent text-light border-secondary px-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="text-info">@comment.Author</strong>
                        <small class="text-secondary">@comment.PostedAt.ToString("MMM dd, yyyy - hh:mm tt")</small>
                    </div>
                    <p class="mb-1 mt-1 text-light">@comment.Text</p>
                </div>
            }
        }
        else
        {
            <p class="text-secondary">No comments yet. Be the first to comment!</p>
        }
    </div>
</div>